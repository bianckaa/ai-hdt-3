# ------------------------------------------------------------------
# Copie este archivo a .env y complete los valores reales.
# El archivo .env esta ignorado por git: nunca suba llaves al repositorio.
# ------------------------------------------------------------------

# --- PostgreSQL + pgvector (los usa docker compose y los scripts) ---
POSTGRES_USER=parachute
POSTGRES_PASSWORD=parachute
POSTGRES_DB=parachute_faqs
POSTGRES_HOST=localhost
# Puerto publicado en el host. Se usa 5433 para no chocar con un Postgres local.
POSTGRES_PORT=5433

# --- Proveedor del LLM (esquema de API compatible con OpenAI) ---
# Elija UNO de los dos bloques y deje el otro comentado.
# Si define ambas llaves, se usa Groq por omision.
# Puede forzar el proveedor con LLM_PROVIDER=groq | nvidia
# LLM_PROVIDER=groq

# Opcion A: Groq  (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Opcion B: NVIDIA Build  (https://build.nvidia.com)
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# --- Parametros de recuperacion ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=4
# Distancia coseno maxima aceptada (0 = identico, 2 = opuesto). Actua solo como
# filtro grueso: con all-MiniLM-L6-v2 sobre texto en espanol los rangos dentro y
# fuera del corpus se traslapan, asi que el LLM decide la relevancia final.
MAX_DISTANCE=0.75
